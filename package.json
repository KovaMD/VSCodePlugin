{
  "name": "kova",
  "displayName": "Kova",
  "description": "Syntax highlighting for Kova Markdown presentations, plus Present with Kova... from the command palette.",
  "version": "0.0.1",
  "publisher": "kovamd",
  "license": "GPL-3.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "kova",
    "markdown",
    "slides",
    "presentation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/KovaMD/VSCodePlugin.git"
  },
  "homepage": "https://kova.md",
  "bugs": {
    "url": "https://github.com/KovaMD/VSCodePlugin/issues"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "grammars": [
      {
        "scopeName": "markdown.kova.injection",
        "path": "./syntaxes/kova.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ]
      }
    ],
    "snippets": [
      {
        "language": "markdown",
        "path": "./snippets/kova.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "kova.present",
        "title": "Present with Kova...",
        "category": "Kova",
        "icon": "$(play-circle)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "kova.present",
          "when": "editorLangId == markdown"
        }
      ],
      "editor/title": [
        {
          "command": "kova.present",
          "when": "editorLangId == markdown",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "check-types": "tsc --noEmit",
    "vscode:prepublish": "npm run check-types && node esbuild.js --production"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.5.4"
  }
}
